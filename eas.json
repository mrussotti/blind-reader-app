{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "image": "latest" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "image": "latest" }
    },
    "production": {
      "ios": { "image": "latest" },
      "android": { "image": "latest" },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://blind-reader-server.onrender.com"
      }
    }
  }
}
